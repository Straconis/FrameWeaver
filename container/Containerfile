# Build environment for FrameWeaver: Rust, the MinGW toolchain for Windows .exe files, NSIS for the installer, and FFmpeg for tests.
FROM docker.io/library/rust:1-bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64 pkg-config libwayland-dev libxkbcommon-dev nsis ffmpeg zip \
 && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-pc-windows-gnu && rustup component add clippy rustfmt
